&tlmm {
	/* SE 6 pin mappings */
	qupv3_se6_redriver_i2c_pins: qupv3_se6_redriver_i2c_pins {
		qupv3_se6_redriver_i2c_active: qupv3_se6_redriver_i2c_active {
			mux {
				pins = "gpio24", "gpio25";
				function = "qup06";
			};

			config {
				pins = "gpio24", "gpio25";
				drive-strength = <2>;
				bias-disable; /* No PULL */
			};
		};
	};
};


