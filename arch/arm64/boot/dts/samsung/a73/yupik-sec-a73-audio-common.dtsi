&wcd93xx_rst_gpio {
	status = "disabled";
	pinctrl-0 = <>;
	pinctrl-1 = <>;
};

&cdc_sec_mi2s_gpios {
	pinctrl-0 = <>;
	pinctrl-1 = <>;
};

&fsa4480 {
	status = "disabled";
};

&wsa_swr_gpios {
	status = "disabled";
};

&wsa883x_0221 {
	status = "disabled";
};

&wsa883x_0222 {
	status = "disabled";
};

&cdc_dmic45_gpios {
	pinctrl-0 = <>;
	pinctrl-1 = <>;
	qcom,tlmm-pins = <>;
};