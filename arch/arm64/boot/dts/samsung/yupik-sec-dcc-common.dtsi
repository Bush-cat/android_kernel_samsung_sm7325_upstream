&dcc {
	link_list@6 {
		qcom,data-sink = "sram";
		qcom,curr-link-list = <6>;
		qcom,link-list =
			config_dcc_pcu,
			config_dcc_epss,
			config_dcc_pimem,
			config_dcc_core,
			//enable_dcc_pll_status,
			config_dcc_gemnoc,
			config_dcc_tsens,
			config_dcc_spmi,
			config_dcc_gpu,
			config_sysnoc,
			config_aggrenoc,
			config_dcc_gcc;
	};

	link_list@4 {
		qcom,data-sink = "sram";
		qcom,curr-link-list = <4>;
		qcom,link-list =
			config_confignoc,
			config_dcc_limits,
			config_dcc_gic,
			config_mmssnoc,
			config_dcc_apps_rsc,
			config_dcc_misc,
			config_dcc_ddr;
	};

	link_list@3 {
		qcom,data-sink = "sram";
		qcom,curr-link-list = <3>;
		qcom,link-list =
			//dcc_async_package,
			config_dcc_modem_rsc,
			config_dcc_lpass_rsc,
			config_dcc_nsp_rsc,
			config_dcc_lpass_cdsp_tunning,
			config_dcc_wpss_rsc,
			config_dcc_video_noc;
	};

	link_list1 {
		qcom,curr-link-list = <0xFF>;
	};

	link_list2 {
		qcom,curr-link-list = <0xFF>;
	};

	link_list3 {
		qcom,curr-link-list = <0xFF>;
	};
};
	
