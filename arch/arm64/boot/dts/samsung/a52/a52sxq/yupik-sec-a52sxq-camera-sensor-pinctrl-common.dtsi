&tlmm {
	cam_sensor_active_mclk0: cam_sensor_active_mclk0 {
		/* Main Rear MCLK */
		mux {
			pins = "gpio64";
			function = "cam_mclk";
		};
		config {
			pins = "gpio64";
			bias-disable; /* No PULL */
			drive-strength = <4>; /* 4 MA */
		};
	};

	cam_sensor_suspend_mclk0: cam_sensor_suspend_mclk0 {
	/* Main Rear MCLK */
		mux {
			pins = "gpio64";
			function = "cam_mclk";
		};
		config {
			pins = "gpio64";
			bias-pull-down; /* No PULL */
			drive-strength = <4>; /* 4 MA */
			output-low;
		};
	};

	cam_sensor_active_mclk1: cam_sensor_active_mclk1 {
		/* BOKEH MCLK */
		mux {
			pins = "gpio65";
			function = "cam_mclk";
		};
		config {
			pins = "gpio65";
			bias-disable; /* No PULL */
			drive-strength = <4>; /* 4 MA */
		};
	};

	cam_sensor_suspend_mclk1: cam_sensor_suspend_mclk1 {
	/* BOKEH MCLK */
		mux {
			pins = "gpio65";
			function = "cam_mclk";
		};
		config {
			pins = "gpio65";
			bias-pull-down; /* No PULL */
			drive-strength = <4>; /* 4 MA */
			output-low;
		};
	};

	cam_sensor_active_mclk2: cam_sensor_active_mclk2 {
		/* UW MCLK */
		mux {
			pins = "gpio66";
			function = "cam_mclk";
		};
		config {
			pins = "gpio66";
			bias-disable; /* No PULL */
			drive-strength = <4>; /* 4 MA */
		};
	};

	cam_sensor_suspend_mclk2: cam_sensor_suspend_mclk2 {
	/* UW MCLK */
		mux {
			pins = "gpio66";
			function = "cam_mclk";
		};
		config {
			pins = "gpio66";
			bias-pull-down; /* No PULL */
			drive-strength = <4>; /* 4 MA */
			output-low;
		};
	};

	cam_sensor_active_mclk3: cam_sensor_active_mclk3 {
		/* Front MCLK */
		mux {
			pins = "gpio68";
			function = "cam_mclk";
		};
		config {
			pins = "gpio68";
			bias-disable; /* No PULL */
			drive-strength = <4>; /* 4 MA */
		};
	};

	cam_sensor_suspend_mclk3: cam_sensor_suspend_mclk3 {
	/* Front MCLK */
		mux {
			pins = "gpio68";
			function = "cam_mclk";
		};
		config {
			pins = "gpio68";
			bias-pull-down; /* No PULL */
			drive-strength = <4>; /* 4 MA */
			output-low;

		};
	};

	cam_sensor_active_mclk4: cam_sensor_active_mclk4 {
		/* Macro Cam MCLK */
		mux {
			pins = "gpio67";
			function = "cam_mclk";
		};
		config {
			pins = "gpio67";
			bias-disable; /* No PULL */
			drive-strength = <4>; /* 4 MA */
		};
	};

	cam_sensor_suspend_mclk4: cam_sensor_suspend_mclk4 {
	/* Macro Cam MCLK */
		mux {
			pins = "gpio67";
			function = "cam_mclk";
		};
		config {
			pins = "gpio67";
			bias-pull-down; /* No PULL */
			drive-strength = <4>; /* 4 MA */
			output-low;

		};
	};

	cam_sensor_active_rst0: cam_sensor_active_rst0 {
	/* Main Rear reset */
		mux {
			pins = "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio20";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};
	cam_sensor_suspend_rst0: cam_sensor_suspend_rst0 {
	/* Main Rear reset */
		mux {
			pins = "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio20";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_active_rst1: cam_sensor_active_rst1 {
	/* BOKEH RESET */
		mux {
			pins = "gpio21";
			function = "gpio";
		};
		config {
			pins = "gpio21";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};
	cam_sensor_suspend_rst1: cam_sensor_suspend_rst1 {
	/* BOKEH RESET */
		mux {
			pins = "gpio21";
			function = "gpio";
		};
		config {
			pins = "gpio21";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

