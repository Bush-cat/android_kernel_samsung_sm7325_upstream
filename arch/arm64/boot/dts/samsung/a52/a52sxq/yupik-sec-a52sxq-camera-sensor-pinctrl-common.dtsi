		};
	};
	mcu_active: mcu_active {
		mux {
			pins = "gpio46","gpio45";
			function = "gpio";
		};

		config {
			pins = "gpio46","gpio45";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	mcu_suspend: mcu_suspend {
		mux {
			pins = "gpio46","gpio45";
			function = "gpio";
		};

		config {
			pins = "gpio46","gpio45";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};

	cam_flash_active: cam_flash_active {
	/* TORCH, FLASH */
		mux {
			pins = "gpio96", "gpio97";
			function = "gpio";
		};
		config {
			pins = "gpio96", "gpio97";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_flash_suspend: cam_flash_suspend {
	/* TORCH, FLASH */
		mux {
			pins = "gpio96", "gpio97";
			function = "gpio";
		};
		config {
			pins = "gpio96", "gpio97";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};
};
