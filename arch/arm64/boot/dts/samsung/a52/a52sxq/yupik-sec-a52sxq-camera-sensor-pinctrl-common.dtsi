	cam_sensor_active_vana2: cam_sensor_active_vana2 {
	/* UW VANA */
		mux {
			pins = "gpio15";
			function = "gpio";
		};
		config {
			pins = "gpio15";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
			output-high;
