	cam_sensor_active_vana0: cam_sensor_active_vana0 {
	/* Rear VANA */
		mux {
			pins = "gpio11";
			function = "gpio";
		};
		config {
			pins = "gpio11";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};
	cam_sensor_suspend_vana0: cam_sensor_suspend_vana0 {
	/* Rear VANA */
		mux {
			pins = "gpio11";
			function = "gpio";
		};
		config {
			pins = "gpio11";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_active_vana1: cam_sensor_active_vana1 {
	/* Bokeh VANA */
		mux {
			pins = "gpio14";
			function = "gpio";
		};
		config {
			pins = "gpio14";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_suspend_vana1: cam_sensor_suspend_vana1 {
	/* Bokeh VANA */
		mux {
