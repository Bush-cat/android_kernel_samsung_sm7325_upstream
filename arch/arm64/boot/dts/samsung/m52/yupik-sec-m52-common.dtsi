&reserved_memory {
	camera_heap: camera_heap {
		alloc-ranges = <0x1 0x80000000 0x0 0x80000000>;
		alignment = <0x0 0x2000000>;
		size = <0x0 0x0>;
		non_gki_size = <0x0 0x1F400000>;
		ion,recyclable;
	};
};

&soc {
	ion_camera_heap {
		compatible = "ion,rbin_heap";
		memory-region = <&camera_heap>;
	};
};

&sdhc_1 {                                                                        
	status = "disabled";                                                     
};

&pcie0 {
	esoc-name = "wlan";
};
