&tlmm {

/*
 * RCAM id 0
 */
	rcam1_mclk_active: rcam1_mclk_active {
		/* Main Rear1 MCLK */
		mux {
			pins = "gpio64";
			function = "cam_mclk";
		};
		config {
			pins = "gpio64";
			bias-disable; /* No PULL */
			drive-strength = <6>; /* 6 MA */
		};
	};

	rcam1_mclk_suspend: rcam1_mclk_suspend {
		/* Main Rear1 MCLK */
		mux {
			pins = "gpio64";
			function = "cam_mclk";
		};
		config {
			pins = "gpio64";
			bias-pull-down; /* No PULL */
			drive-strength = <6>; /* 6 MA */
			output-low;
		};
	};

	rcam1_rst_active: rcam1_rst_active {
		/* Main Rear1 RESET */
		mux {
			pins = "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio20";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	rcam1_rst_suspend: rcam1_rst_suspend {
		/* Main Rear1 RESET */
		mux {
			pins = "gpio20";
			function = "gpio";
		};
		config {
			pins = "gpio20";
			bias-pull-down; /* No PULL */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};
/*
