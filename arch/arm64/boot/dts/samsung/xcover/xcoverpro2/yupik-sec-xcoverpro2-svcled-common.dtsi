/* SEC SVCLED setting */
&pm8350c_rgb {
	step = <120>;

	red {
		br_ratio_normal = <25>;
		br_ratio_lpm = <25>;
	};

	green {
		br_ratio_normal = <5>;
		br_ratio_lpm = <5>;
	};

	blue {
		br_ratio_normal = <22>;
		br_ratio_lpm = <22>;
	};
};
