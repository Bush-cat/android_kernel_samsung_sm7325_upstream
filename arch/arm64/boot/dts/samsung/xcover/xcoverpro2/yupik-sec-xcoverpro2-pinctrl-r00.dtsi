#include "yupik-sec-xcoverpro2-camera-sensor-pinctrl-common.dtsi"

&tlmm {
	hot_key {
		key_hot_default: key_hot_default {
			mux {
				pins = "gpio24";
				function = "gpio";
			};
			config {
				input-enable;
				bias-disable;
				drive-strength = <2>;
			};
		};
	};

	emergency_key {
		key_emergency_default: key_emergency_default {
			mux {
				pins = "gpio25";
				function = "gpio";
			};
			config {
				input-enable;
				bias-disable;
				drive-strength = <2>;
			};
		};
	};
};


